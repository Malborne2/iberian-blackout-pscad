    <Definition classid="UserCmpDefn" name="SyncUnit_v1bad" group="" url="" version="" build="" crc="104275492" instances="0" key="" view="false" date="0" id="1200000301">
      <paramlist>
        <param name="Description" value="Synchronous unit (machine + AVR)" />
      </paramlist>
