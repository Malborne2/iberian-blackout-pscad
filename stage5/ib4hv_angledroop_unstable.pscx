    <Definition classid="UserCmpDefn" name="HVDC_T" group="" url="" version="" build="" crc="72456307" instances="0" key="" view="false" date="1795141062" id="1300000601">
      <paramlist>
        <param name="Description" value="HVDC voltage-source terminal: 2-level bridge, SRF-PLL, dq current control, constant-P or AC-emulation P reference, Q(V) channel, UV blocking latch" />
      </paramlist>
      <form name="HVDC_T" w="320" h="400" splitter="60">
        <category name="HVDC" visible="true">
          <parameter desc="Rated MVA" name="Sbase" group="" unit="MVA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1000</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Voltage pu gain 1/(Vbase*sqrt(2/3))" name="Kv" group="" unit="1/kV" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.003061862178</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Current pu gain sqrt3*Vbase/(sqrt2*Sbase)" name="Ki" group="" unit="1/kA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.4898979486</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Filter inductance (0.15 pu)" name="Lf" group="" unit="H" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.07639437268</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Filter capacitance per phase" name="Cf" group="" unit="uF" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.166666667</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Filter damping resistor in series with Cf (pu of Zbase)" name="Rf" group="" unit="ohm" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>3.2</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Modulation constant -Vbase_pk/(Vdc/2)" name="Kmod" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>-0.8164965809</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Carrier phase offset" name="CarrPh" group="" unit="deg" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Overvoltage trip threshold (on VDF)" name="Vt" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.9</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Overvoltage trip delay (definite time)" name="Tt" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.05</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Hard limit on id_ref (pu of Sbase)" name="Imax" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.1</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="P reference, pu of Sbase (negative = export)" name="Pref" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="1 = constant P, 3 = AC-emulation angle control" name="PMODE" group="" unit="" min="-2147483648" max="2147483647" content_type="Constant" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC-emulation gain, pu per degree (negative)" name="Kang" group="" unit="pu/deg" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC-emulation lag (report: 50 s)" name="Tang" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>50.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AC voltage set-point for the Q channel" name="Vset" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.025</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Q channel PI gain" name="Kq" group="" unit="pu/pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>20.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Q channel PI time constant" name="Tq" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.02</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Q channel upper limit (pu of Sbase)" name="Qmax" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.4</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Q channel lower limit (pu of Sbase)" name="Qmin" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>-0.6</value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
      </form>
