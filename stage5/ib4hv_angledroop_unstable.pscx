    <Definition classid="UserCmpDefn" name="RES_GFM" group="" url="" version="" build="" crc="0" instances="0" key="" view="false" date="0" id="1300000701">
      <paramlist>
        <param name="Description" value="Switching converter plant: 2-level IGBT bridge, SRF-PLL, decoupled dq current control, fixed PF, OV relay, gate blocking, shared DC rail" /></paramlist>
      <form name="RES_Plant" w="320" h="400" splitter="60">
        <category name="Plant" visible="true">
          <parameter desc="Rated MVA" name="Sbase" group="" unit="MVA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>300</value><cond /><help /><vis /></parameter><parameter desc="Voltage pu gain 1/(Vbase*sqrt(2/3))" name="Kv" group="" unit="1/kV" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.003061862178</value><cond /><help /><vis /></parameter><parameter desc="Current pu gain sqrt3*Vbase/(sqrt2*Sbase)" name="Ki" group="" unit="1/kA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1.632993162</value><cond /><help /><vis /></parameter><parameter desc="Filter inductance (0.15 pu)" name="Lf" group="" unit="H" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.2546479089</value><cond /><help /><vis /></parameter><parameter desc="Filter capacitance per phase" name="Cf" group="" unit="uF" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.35</value><cond /><help /><vis /></parameter><parameter desc="Filter damping resistor in series with Cf (pu of Zbase)" name="Rf" group="" unit="ohm" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>10.66666667</value><cond /><help /><vis /></parameter><parameter desc="Modulation constant -Vbase_pk/(Vdc/2)" name="Kmod" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>-0.8164965809</value><cond /><help /><vis /></parameter><parameter desc="Q/P = tan(acos(pf))" name="Kpf" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>-0.1751820703</value><cond /><help /><vis /></parameter><parameter desc="Carrier phase offset" name="CarrPh" group="" unit="deg" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0</value><cond /><help /><vis /></parameter><parameter desc="Hard limit on id_ref (pu of Sbase)" name="Imax" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1.1</value><cond /><help /><vis /></parameter><parameter desc="Rate limit on Pref (pu/s; 1e6 = bypass)" name="RampLim" group="" unit="pu/s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1000000</value><cond /><help /><vis /></parameter><parameter desc="Overvoltage trip threshold, block 1 (on VDF)" name="Vt1" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1.1</value><cond /><help /><vis /></parameter><parameter desc="Overvoltage trip delay, block 1" name="Tt1" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.001</value><cond /><help /><vis /></parameter><parameter desc="Overvoltage trip threshold, block 2 (on VDF)" name="Vt2" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1.5</value><cond /><help /><vis /></parameter><parameter desc="Overvoltage trip delay, block 2" name="Tt2" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.001</value><cond /><help /><vis /></parameter><parameter desc="Overvoltage trip threshold, block 3 (on VDF)" name="Vt3" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1.5</value><cond /><help /><vis /></parameter><parameter desc="Overvoltage trip delay, block 3" name="Tt3" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0.001</value><cond /><help /><vis /></parameter><parameter desc="Number of sub-blocks in use (1-3, informational)" name="Nsub" group="" unit="" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1</value><cond /><help /><vis /></parameter><parameter desc="Share of block 1 (pu of plant rating)" name="Share1" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1</value><cond /><help /><vis /></parameter><parameter desc="Share of block 2 (0 = not in use)" name="Share2" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0</value><cond /><help /><vis /></parameter><parameter desc="Share of block 3 (0 = not in use)" name="Share3" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0</value><cond /><help /><vis /></parameter><parameter desc="OV relay measurement: 0 = internal VDF, 1 = POI RMS" name="MeasSide" group="" unit="" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0</value><cond /><help /><vis /></parameter><parameter desc="Converter control mode: 0 = grid-following, 2 = grid-forming" name="Qmode" group="" unit="" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>0</value><cond /><help /><vis /></parameter><parameter desc="Voltage set-point for the Q(V) droop (pu of Vbase)" name="Vset" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false"><value>1</value><cond /><help /><vis /></parameter></category>
      </form>
