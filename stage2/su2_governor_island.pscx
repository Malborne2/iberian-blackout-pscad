    <Definition classid="UserCmpDefn" name="SyncUnitB" group="" url="" version="" build="" crc="120044174" instances="0" key="" view="false" date="1794815664" id="186489297">
      <paramlist>
        <param name="Description" value="Synchronous unit (machine + AVR)" />
      </paramlist>
      <form name="SyncUnitB" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <parameter desc="Rated MVA" name="Sbase" group="" unit="MVA" min="1.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>300.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated line-to-line kV" name="Vbase" group="" unit="kV" min="0.1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>18.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Inertia constant" name="H" group="" unit="s" min="0.1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>3.117</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial active power" name="P0" group="" unit="MW" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>60.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial reactive power" name="Q0" group="" unit="Mvar" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>2.4</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial terminal voltage" name="V0" group="" unit="pu" min="0.1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial rotor angle" name="Ph0" group="" unit="rad" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="0 = slow Q regulator, 1 = fast AVR" name="Vctl" group="" unit="" min="0" max="1" content_type="Constant" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Exciter release time" name="Tstart" group="" unit="s" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated RMS line-to-neutral kV (= Vbase/sqrt(3))" name="VbaseLN" group="" unit="kV" min="0.1" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>10.392304845413264</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated stator current kA (= Sbase/(sqrt(3)*Vbase))" name="Ibase" group="" unit="kA" min="0.001" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>9.622504486493764</value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
      </form>
