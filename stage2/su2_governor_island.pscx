    <Definition classid="UserCmpDefn" name="SyncUnit" group="" url="" version="" build="" crc="4982571" instances="0" key="" view="false" date="1794865381" id="1200000301">
      <paramlist>
        <param name="Description" value="Synchronous unit (machine + AVR)" />
      </paramlist>
      <form name="SyncUnit" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <parameter desc="Rated MVA" name="Sbase" group="" unit="MVA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>300.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated line-to-line kV" name="Vbase" group="" unit="kV" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>18.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated RMS line-to-neutral kV" name="VbaseLN" group="" unit="kV" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>10.392304845413264</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Rated stator current kA" name="Ibase" group="" unit="kA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>9.622504486493764</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Inertia constant" name="H" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>3.117</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial active power" name="P0" group="" unit="MW" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>60.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial reactive power" name="Q0" group="" unit="Mvar" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>2.4</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial terminal voltage" name="V0" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Initial rotor angle" name="Ph0" group="" unit="rad" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="0 = slow AVR (baseline), 1 = fast" name="Vctl" group="" unit="" min="0" max="1" content_type="Constant" type="Integer" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Exciter release time" name="Tstart" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.5</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Mechanical torque, pu (= P0/Sbase)" name="Pmec" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.2</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Governor gain = 1/droop (0 = none)" name="Kgov" group="" unit="pu/pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Governor-turbine time constant" name="Tgov" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>5.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Governor output limit (+/-)" name="GovLim" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.3</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AVR gain KA (excac AC1C KA_1)" name="KA" group="" unit="" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>400.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AVR rate feedback KF (KF_1)" name="KF" group="" unit="" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.03</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="AVR rate feedback TF (TF_1)" name="TF" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.0</value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
      </form>
