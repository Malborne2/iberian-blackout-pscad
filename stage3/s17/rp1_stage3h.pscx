    <Definition classid="UserCmpDefn" name="RES_Plant" group="" url="" version="" build="" crc="76314582" instances="0" key="" view="false" date="1794862643" id="1300000501">
      <paramlist>
        <param name="Description" value="Switching converter plant: 2-level IGBT bridge, SRF-PLL, decoupled dq current control, fixed PF, OV relay, gate blocking, shared DC rail" />
      </paramlist>
      <form name="RES_Plant" w="320" h="400" splitter="60">
        <category name="Plant" visible="true">
          <parameter desc="Rated MVA" name="Sbase" group="" unit="MVA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>300</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Voltage pu gain 1/(Vbase*sqrt(2/3))" name="Kv" group="" unit="1/kV" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.003061862178</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Current pu gain sqrt3*Vbase/(sqrt2*Sbase)" name="Ki" group="" unit="1/kA" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.632993162</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Filter inductance (0.15 pu)" name="Lf" group="" unit="H" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.2546479089</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Filter capacitance per phase" name="Cf" group="" unit="uF" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.35</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Modulation constant -Vbase_pk/(Vdc/2)" name="Kmod" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>-0.8164965809</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Q/P = tan(acos(pf))" name="Kpf" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>-0.1751820703</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Carrier phase offset" name="CarrPh" group="" unit="deg" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Overvoltage trip threshold (on VDF)" name="Vt" group="" unit="pu" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>1.1</value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="Overvoltage trip delay (definite time)" name="Tt" group="" unit="s" min="-1e+308" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value>0.001</value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
      </form>
